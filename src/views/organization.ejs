<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %>">

    <p>Description: <%= organizationDetails.description %></p>

    <h3>Service Projects</h3>
    <ul>
        <% if (projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>:</strong>
                        <%= project.title %>
                    </a>
                    <p><strong>Description:</strong> <%= project.description %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                </li>
            <% }); %>
        <% } else { %>
            <li>No service projects listed.</li>
        <% } %>
    </ul>
</main>



<%- include('partials/footer') %>