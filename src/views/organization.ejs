<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %>">

    <p>Description: <%= organizationDetails.description %></p>

    <h3>Service Projects</h3>
    <ul>
        <% projects.forEach(project=> { %>
            <li><a href="/project/<%= project.project_id %>">
                    <strong><%= new Date(project.p_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>: </strong>
                    <%= project.p_title %>
                </a></li>
            <% }) %>
    </ul>
</main>



<%- include('partials/footer') %>